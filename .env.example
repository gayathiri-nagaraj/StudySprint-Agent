# Copy this file to .env for local configuration if needed.
SECRET_KEY=replace-with-a-local-secret
DATABASE_URL=sqlite:///studysprint.db
APP_ENV=development
RATE_LIMIT_STORAGE_URI=memory://
TRUSTED_PROXY_HOPS=0

# Required once when migrating an existing pre-authentication database.
LEGACY_OWNER_EMAIL=student@example.com
LEGACY_OWNER_PASSWORD=replace-with-a-strong-password

# Production example (use a managed PostgreSQL URL and shared Redis storage):
# APP_ENV=production
# SECRET_KEY=generate-a-long-random-secret
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# RATE_LIMIT_STORAGE_URI=redis://USER:PASSWORD@REDIS_HOST:6379/0
# TRUSTED_PROXY_HOPS=1
# WEB_CONCURRENCY=2
